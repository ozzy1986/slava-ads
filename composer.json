{
    "name": "slava-ads/backend",
    "description": "Lead intake backend for slava-ads.ru",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "SlavaAds\\": "api/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlavaAds\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
