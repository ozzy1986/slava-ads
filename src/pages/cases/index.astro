---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CaseCard from "@/components/CaseCard.astro";
import CtaBand from "@/components/CtaBand.astro";
import { cases, caseHighlights } from "@/data/content";
import { site } from "@/config/site";

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: cases.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `${c.title} — ${c.metric.value} ${c.metric.label}`,
    url: new URL(`/cases/${c.id}`, site.url).href,
  })),
};
---

<Layout
  title="Кейсы — результаты в цифрах"
  description="Реальные кейсы по контекстной рекламе и сайтам: от 20 до 200 заявок в неделю. Яндекс Директ и Google Ads в России, СНГ и США."
  path="/cases"
  schema={[itemList]}
>
  <Breadcrumbs items={[{ label: "Кейсы" }]} />

  <section class="pt-10 md:pt-14">
    <div class="container-x">
      <div class="reveal max-w-3xl">
        <p class="t-sec">Портфолио</p>
        <h1 class="t-serif-hero mt-4">Кейсы, где цифры говорят за себя</h1>
        <p class="mt-5 max-w-2xl text-[16px] leading-[1.75] text-[var(--color-mute)]">
          Работаю не на количество, а на результат: веду ограниченное число
          проектов и с каждым сотрудничаю долго. Ниже — задачи, решения и
          измеримые результаты.
        </p>
      </div>

      <div class="reveal mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4" style="--sd:120ms;">
        {
          caseHighlights.map((h) => (
            <div class="resume-skills-card flex flex-col items-center justify-center text-center">
              {h.value && <p class="stat-num text-2xl">{h.value}</p>}
              <p class={h.value ? "mt-1.5 text-xs text-[var(--color-mute)]" : "text-[15px] font-semibold leading-snug text-[var(--color-head-ink)]"}>{h.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pt-12">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((c, i) => <CaseCard item={c} index={i} />)}
      </div>

      <CtaBand
        class="mt-14"
        title="Хотите такие же результаты?"
        subtitle="Оставьте заявку — разберу вашу нишу и предложу план."
        source="cases-cta"
      />
    </div>
  </section>
</Layout>
