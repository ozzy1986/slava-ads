---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
---

<Layout title="Страница не найдена" path="/404" noindex={true} bare={true}>
  <section class="grid min-h-screen place-items-center py-24">
    <div class="container-x text-center">
      <p class="t-sec">Ошибка</p>
      <p class="mt-4 font-display text-[clamp(5rem,18vw,11rem)] leading-none text-[var(--color-brand-blue)]">404</p>
      <h1 class="mt-2 font-display text-[26px] md:text-[32px]">Страница потерялась</h1>
      <p class="mx-auto mt-4 max-w-md text-[16px] leading-[1.75] text-[var(--color-mute)]">
        Похоже, такой страницы нет. Зато есть кейсы с реальными цифрами и поток
        заявок для вашего бизнеса.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary !px-7 !py-4">
          На главную
          <Icon name="arrow" size={20} />
        </a>
        <a href="/cases" class="btn btn-ghost !px-7 !py-4">Смотреть кейсы</a>
      </div>
    </div>
  </section>
</Layout>
