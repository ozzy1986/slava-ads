---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import { getCollection, render } from "astro:content";
import { site } from "@/config/site";
import { person, personRef, organizationRef } from "@/config/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const more = all.filter((p) => p.id !== post.id).slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString("ru-RU", { day: "numeric", month: "long", year: "numeric" });

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: personRef,
  publisher: organizationRef,
  mainEntityOfPage: new URL(`/blog/${post.id}`, site.url).href,
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  schema={[schema, person]}
>
  <Breadcrumbs items={[{ label: "Блог", href: "/blog" }, { label: post.data.category }]} />

  <article class="pt-10 md:pt-14">
    <div class="container-x max-w-3xl">
      <div class="reveal flex flex-wrap items-center gap-3 text-xs text-[var(--label-gray)]">
        <span class="rounded-full bg-[var(--band-filled)] px-3 py-1 font-medium text-[var(--color-brand-blue)]">
          {post.data.category}
        </span>
        <span>{fmt(post.data.pubDate)}</span>
        <span>· {post.data.readingMinutes} мин чтения</span>
      </div>

      <h1 class="t-serif-hero reveal mt-5">{post.data.title}</h1>
      <p class="reveal mt-4 text-[17px] leading-[1.7] text-[var(--color-mute)]">{post.data.description}</p>

      <div class="reveal prose-article mt-10">
        <Content />
      </div>

      <CtaBand
        class="mt-12"
        title="Нужен поток клиентов?"
        subtitle="Настрою рекламу и сайт под ваш бизнес. Разбор задачи — бесплатно."
        source="blog-cta"
      />
    </div>

    {/* More posts */}
    <section class="section">
      <div class="container-x">
        <h2 class="reveal font-display text-2xl">Ещё по теме</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          {
            more.map((p) => (
              <a href={`/blog/${p.id}`} class="resume-skills-card reveal group !p-7">
                <span class="text-xs font-medium text-[var(--color-brand-blue)]">{p.data.category}</span>
                <h3 class="mt-3 text-xl leading-snug">{p.data.title}</h3>
                <p class="mt-3 text-[15px] leading-[1.6] text-[var(--color-mute)]">{p.data.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</Layout>

<style is:global>
  .prose-article {
    color: var(--color-paper);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .prose-article h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-article h3 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    color: var(--color-paper);
  }
  .prose-article p {
    margin-bottom: 1.1rem;
    color: var(--color-mute);
  }
  .prose-article ul,
  .prose-article ol {
    margin: 1.1rem 0;
    padding-left: 1.25rem;
    color: var(--color-mute);
  }
  .prose-article li {
    margin-bottom: 0.5rem;
  }
  .prose-article ul li::marker {
    color: var(--color-signal-500);
  }
  .prose-article strong {
    color: var(--color-paper);
    font-weight: 600;
  }
  .prose-article a {
    color: var(--color-signal-400);
    text-decoration: underline;
  }
</style>
