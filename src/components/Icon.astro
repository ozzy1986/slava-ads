---
/**
 * Lightweight inline SVG icon set (stroke-based, 24x24).
 * Keeps zero runtime JS and crisp rendering at any size.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
}
const { name, class: className = "", size = 24 } = Astro.props;

const paths: Record<string, string> = {
  target:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>',
  gem: '<path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20"/><path d="M9 3 6 9l6 12 6-12-3-6"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/>',
  rocket:
    '<path d="M5 13c-1.5 1.3-2 5-2 5s3.7-.5 5-2"/><path d="M14.5 4.5C18 4 20 6 19.5 9.5c-.4 3-3.5 6-9 9l-3-3c3-5.5 6-8.6 9-9z"/><circle cx="14.5" cy="9.5" r="1.5"/>',
  users:
    '<circle cx="9" cy="8" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5a3.5 3.5 0 0 1 0 7"/><path d="M18 14a6 6 0 0 1 4 6"/>',
  layout:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  palette:
    '<path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2 0-1.5 1-2 2-2h1a4 4 0 0 0 4-4c0-4.5-4-8-11-8z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/>',
  arrow:
    '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  check: '<path d="m4 12 5 5L20 6"/>',
  spark:
    '<path d="M12 3v4m0 10v4m9-9h-4M7 12H3m13.5-6.5-2.8 2.8m-5.4 5.4-2.8 2.8m11 0-2.8-2.8m-5.4-5.4L5.5 5.5"/>',
  chart:
    '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
  bolt: '<path d="M13 3 4 14h7l-1 7 9-11h-7z"/>',
  shield: '<path d="M12 3 5 6v5c0 5 3 8 7 10 4-2 7-5 7-10V6z"/><path d="m9 12 2 2 4-4"/>',
};

const whatsapp =
  '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z" fill="none"/><path d="M8.5 8.2c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.5l.7 1.6c.1.2.1.4 0 .5l-.4.6c-.1.2-.2.3 0 .6.5.8 1.2 1.4 2 1.8.3.1.4.1.6-.1l.5-.6c.2-.2.3-.2.5-.1l1.5.7c.2.1.4.2.4.4 0 .6-.3 1.3-1.4 1.5-1 .2-2.3 0-4-1.2-1.9-1.4-2.9-3.2-3-3.6-.1-.4-.4-1.4.2-2.3z"/>';
const telegram =
  '<path d="m21 5-2.5 13.5c-.2.9-.7 1.1-1.4.7l-3.9-2.9-1.9 1.8c-.2.2-.4.4-.8.4l.3-4 7.3-6.6c.3-.3-.1-.4-.5-.2L8.4 13 4.6 11.8c-.8-.3-.8-.8.2-1.2l14.6-5.6c.7-.3 1.3.2 1.1 1z"/>';

const isFilled = name === "whatsapp" || name === "telegram";
const inner = name === "whatsapp" ? whatsapp : name === "telegram" ? telegram : paths[name] || "";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
/>
