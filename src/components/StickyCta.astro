---
// Mobile-only sticky lead button. No phone/email — leads only.
import { cta } from "@/data/content";
---
<div
  class="fixed inset-x-0 bottom-0 z-30 p-3 lg:hidden"
  data-sticky-cta
  style="transform: translateY(120%); transition: transform .3s cubic-bezier(.22,1,.36,1);"
>
  <button
    class="btn btn-primary w-full !py-3.5 shadow-[0_-10px_30px_-14px_rgba(16,24,40,0.35)]"
    data-lead="sticky-mobile"
  >
    {cta.button}
  </button>
</div>

<script>
  const cta = document.querySelector("[data-sticky-cta]") as HTMLElement | null;
  if (cta) {
    const onScroll = () => {
      const show = window.scrollY > 600;
      cta.style.transform = show ? "translateY(0)" : "translateY(120%)";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
