---
import { qualification } from "@/data/content";
---

<section class="section scroll-mt-28" id="qualification">
  <div class="container-x">
    <div class="mx-auto max-w-[820px] text-center">
      <p class="t-sec reveal">Квалификация</p>
      <h2 class="t-serif-title reveal mt-4" style="--sd:120ms;">Подтверждённая экспертиза</h2>
      <p class="reveal mt-4 text-[16px] leading-[1.75] text-[var(--color-mute)]" style="--sd:200ms;">
        {qualification.note}
      </p>
    </div>

    <div class="qual-grid mt-10">
      {
        qualification.docs.map((d, i) => (
          <article class="qual-card reveal" style={`--sd:${120 + i * 70}ms;`}>
            <a class="qual-thumb" href={d.src} target="_blank" rel="noopener nofollow" tabindex="-1" aria-hidden="true">
              <img src={d.src} alt={`${d.type} — ${d.title}`} loading="lazy" decoding="async" />
            </a>
            <div class="qual-text">
              <p class="qual-title">{d.title}</p>
              <p class="qual-meta">{d.provider ? `${d.provider} · ${d.type}` : d.type}</p>
              <a class="qual-link" href={d.src} target="_blank" rel="noopener nofollow">Открыть оригинал</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .qual-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) { .qual-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .qual-grid { grid-template-columns: repeat(3, 1fr); } }

  .qual-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: var(--band-filled);
    border-radius: var(--radius-card);
    padding: 16px;
  }
  .qual-thumb {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 72px;
    padding: 6px;
    background: #fff;
    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .qual-thumb:hover {
    transform: translateY(-2px);
    border-color: rgba(28, 124, 245, 0.4);
    box-shadow: 0 14px 30px -18px rgba(16, 24, 40, 0.35);
  }
  .qual-thumb img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .qual-text {
    min-width: 0;
    padding-top: 2px;
  }
  .qual-title {
    font-family: var(--font-sans);
    color: var(--color-head-ink);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .qual-meta {
    color: var(--color-body-ink);
    margin: 4px 0 0;
    font-size: 13.5px;
  }
  .qual-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-brand-blue);
    text-decoration: none;
  }
  .qual-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 380px) {
    .qual-card { gap: 12px; padding: 14px; }
    .qual-thumb { width: 76px; height: 60px; }
  }
</style>