# Lead backend configuration. Copy to .env on the server and fill real values.
# NEVER commit the real .env (it is gitignored).

# --- MySQL ---
DB_HOST=localhost
DB_NAME=slavaads_leads
DB_USER=slavaads
DB_PASS=change_me

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat id to receive leads (your personal id or a group id).
# Discover it: send a message to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
TELEGRAM_CHAT_ID=

# --- Email (Brevo SMTP — same relay as ru-atomy.ru on this VPS) ---
LEAD_EMAIL=ozeritski@gmail.com
EMAIL_FROM=ozeritski@gmail.com
EMAIL_FROM_NAME=slava-ads.ru
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# --- Admin panel ---
# Username and password hash (generate hash with: php -r "echo password_hash('yourpass', PASSWORD_DEFAULT);")
ADMIN_USER=admin
ADMIN_PASS_HASH=

# --- Anti-spam ---
# Per-IP limits for stored leads.
RATE_PER_MINUTE=2
RATE_PER_HOUR=5
RATE_PER_DAY=5

# Secret for signed form tokens (blocks instant POSTs; token lives up to 24h).
# Generate: php -r "echo bin2hex(random_bytes(32));"
# Empty value falls back to ADMIN_PASS_HASH; if both are empty the check is off.
FORM_SECRET=

# Comma-separated IPs that are silently dropped (known spam sources).
# Example: BLOCKED_IPS=161.104.105.34,203.0.113.7
BLOCKED_IPS=

# Trust CF-Connecting-IP / X-Forwarded-For. Enable ONLY when Apache is behind
# a trusted proxy (Cloudflare/nginx) and the origin is not directly reachable.
# Direct Apache must keep 0, otherwise clients can spoof their IP and bypass
# rate limiting.
TRUST_PROXY_HEADERS=0

# --- Self-hosted CAPTCHA ---
# Stateless image CAPTCHA rendered by the backend; no external services.
# The secret signs the challenge token. Empty value falls back to FORM_SECRET,
# then ADMIN_PASS_HASH. If all are empty the CAPTCHA is disabled.
# Generate a dedicated value: php -r "echo bin2hex(random_bytes(32));"
CAPTCHA_SECRET=
